# Read by code-docker's ootb.sh/migrate.sh when it wires this project in through
# EXTRA_INCLUDE. Schema: code-docker's docs/tips/ootb-manifest.md. Plain shell env file,
# sourced directly - assignments only, no other code.

OOTB_NAME="Blender"
OOTB_DESCRIPTION="code-docker에 붙는 Blender 프로바이더 (GUI 상주 + wayvnc, 공식 Blender MCP를 토큰으로 감싸 에이전트에 연결)"
OOTB_COMPOSE_INCLUDE="code-docker-blender.yml"

# router's VNC tab / App Routes / Dev Proxy only accept code-docker and dind as targets
# by default (self-SSRF hardening). blender-vnc is this container's alias on the
# VNC-only network - the same value as VNC_BIND_ALIAS in code-docker-blender.yml.
OOTB_ROUTER_ALLOWED_TARGET_HOSTS="blender-vnc"

# The MCP endpoint's bearer token. Generated rather than prompted: a random value is
# strictly correct, so asking would only break "install it and it works".
#
# It is a real boundary: execute_blender_code runs arbitrary Python as root in the
# Blender container, and the endpoint sits on code-docker-internal, which dind's
# containers and other providers share.
OOTB_GENERATE_SECRETS="BLENDER_MCP_TOKEN"
