# These are read from *code-docker's* .env, not from this directory - this repo has no
# compose file of its own to load an .env for (see code-docker-blender.yml's header).
# ootb.sh writes BLENDER_MCP_TOKEN there for you; the rest are optional overrides.

# Bearer token for the MCP endpoint (blender:8765). Generated by ootb.sh
# (OOTB_GENERATE_SECRETS). The Blender container refuses to serve MCP if it is empty.
BLENDER_MCP_TOKEN=

# Headless output resolution - what a person sees over VNC and what the window
# screenshot tool captures. Larger costs VNC bandwidth and screenshot size (the MCP
# downscales a screenshot that would exceed ~780KB, to fit its 1MB message limit).
#BLENDER_SCREEN_SIZE=1920x1080

# The directory both containers share at the same path: .blend files, exports, renders.
# Changing it after the first start leaves the old files in the volume at the old path.
#BLENDER_WORK_DIR=/code/blender

# wayvnc-level auth. Off by default: the VNC network is internal: true and shared only
# with router, which fronts it with its own login. Separate from code-docker-chrome's
# VNC_PASSWORD on purpose.
#BLENDER_VNC_PASSWORD=
